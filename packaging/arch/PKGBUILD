# Maintainer: Stasyao37 <kapitonov.stass@gmail.com>
pkgname=shelf-fm
_name=shelf
pkgver=0.1.2
pkgrel=1
pkgdesc="Glass file manager for Hyprland in Qt 6 / QML"
arch=('x86_64' 'aarch64')
url="https://github.com/Stasyao37/shelf"
license=('GPL-3.0-or-later' 'OFL-1.1' 'MIT' 'CC0-1.0')
# QML-модули (Controls, Effects, Layouts, QtCore) входят в qt6-declarative;
# SVG и Wayland — плагины, грузятся во время работы
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland'
         'glib2' 'xdg-utils' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja')
optdepends=('tumbler: миниатюры картинок и PDF'
            'ffmpegthumbnailer: миниатюры видео'
            'matugen: палитра из обоев')
# В AUR уже есть shelf-git — другая программа (закладки на файлы); -fm — чтобы не путать
source=("$_name-$pkgver.tar.gz::$url/archive/v$pkgver/$_name-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -B build -S "$_name-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_SKIP_INSTALL_RPATH=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_name-$pkgver/fonts/OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm644 "$_name-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
